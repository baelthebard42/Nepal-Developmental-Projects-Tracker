# Supabase (Phase 1: read-only public data). Without these the app uses the bundled sample JSON.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only for npm run db:migrate / db:seed (local use; do not add to Vercel)
SUPABASE_DB_CONNECTION_STR=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
